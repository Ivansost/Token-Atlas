# Backend container settings.
#
# ALLOWED_ORIGINS is the deployed frontend's origin, comma-separated if more than one. Localhost is
# always permitted, so development needs no value here. Without it a deployed frontend is blocked
# by CORS, and its WebSocket handshake is rejected by the same exact-origin list.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Rolling inference limits per backend process. Modal's max_containers remains the hard spending
# ceiling across processes; these keep one client or a rotating-client flood from owning a running
# container. Defaults are shown here and can be tuned without rebuilding the image.
RATE_WINDOW_SECONDS=60
MAX_RUNS_PER_CLIENT_WINDOW=6
MAX_RUNS_GLOBAL_WINDOW=24
MAX_CONNECTIONS_PER_CLIENT=3

# Most hosts inject PORT themselves; the container falls back to 8000.
# PORT=8000
