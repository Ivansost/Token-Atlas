# Where the backend lives. Defaults to http://localhost:8000 when unset.
#
# The WebSocket URL is derived from this by swapping the scheme, so an https:// value here becomes
# wss:// automatically — which matters, because a deployed https frontend cannot open a plain ws://
# socket. Browsers block it as mixed content, and the failure looks like "the model is offline".
#
# Local development:   leave unset
# Deployed:            VITE_API_URL=https://your-backend-host.example.com
VITE_API_URL=
